<Window x:Class="VoiceChanger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoiceChanger"
        xmlns:vm="clr-namespace:VoiceChanger.ViewModels"
        mc:Ignorable="d"
        Title="Voice Changer" Height="600" Width="960">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,10,0">
            <TextBlock Text="Input Device" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}"
                      DisplayMemberPath="FriendlyName"/>
            <TextBlock Text="Output Device" FontWeight="Bold" Margin="0,8,0,0"/>
            <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}"
                      DisplayMemberPath="FriendlyName"/>
            <StackPanel Orientation="Vertical" Margin="0,12,0,0">
                <Button Content="Start" Width="100" Command="{Binding StartCommand}"/>
                <Button Content="Stop" Width="100" Margin="0,8,0,0" Command="{Binding StopCommand}"/>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                <Button Content="Refresh" Width="100" Command="{Binding RefreshDevicesCommand}"/>
                <Button Content="Save Preset" Width="100" Margin="0,8,0,0" Command="{Binding SavePresetCommand}"/>
                <Button Content="Load Preset" Width="100" Margin="0,8,0,0" Command="{Binding LoadPresetCommand}"/>
                <Button Content="Moe Voice" Width="100" Margin="0,8,0,0" Command="{Binding ApplyMoeVoiceCommand}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Input Gain"/>
                <Slider Minimum="0" Maximum="4" Value="{Binding InputGain}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

                <TextBlock Text="Pitch (semitones)" Margin="0,8,0,0"/>
                <Slider Minimum="-12" Maximum="12" Value="{Binding PitchSemitones}" TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Text="Formant Shift" Margin="0,8,0,0"/>
                <Slider Minimum="-1" Maximum="1" Value="{Binding FormantShift}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>

                <TextBlock Text="EQ Low (dB)" Margin="0,8,0,0"/>
                <Slider Minimum="-24" Maximum="24" Value="{Binding EqLowDb}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="EQ Mid (dB)"/>
                <Slider Minimum="-24" Maximum="24" Value="{Binding EqMidDb}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="EQ High (dB)"/>
                <Slider Minimum="-24" Maximum="24" Value="{Binding EqHighDb}" TickFrequency="1" IsSnapToTickEnabled="True"/>

                <TextBlock Text="Echo Delay (ms)" Margin="0,8,0,0"/>
                <Slider Minimum="0" Maximum="1000" Value="{Binding EchoMs}" TickFrequency="50" IsSnapToTickEnabled="True"/>
                <TextBlock Text="Echo Feedback"/>
                <Slider Minimum="0" Maximum="0.95" Value="{Binding EchoFeedback}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                <TextBlock Text="Echo Mix"/>
                <Slider Minimum="0" Maximum="1" Value="{Binding EchoMix}" TickFrequency="0.05" IsSnapToTickEnabled="True"/>

                <TextBlock Text="Noise Gate Threshold" Margin="0,8,0,0"/>
                <Slider Minimum="0" Maximum="0.2" Value="{Binding GateThreshold}" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                <TextBlock Text="Noise Gate Release"/>
                <Slider Minimum="0.001" Maximum="0.5" Value="{Binding GateRelease}" TickFrequency="0.01" IsSnapToTickEnabled="True"/>

                <TextBlock Text="Output Gain" Margin="0,8,0,0"/>
                <Slider Minimum="0" Maximum="4" Value="{Binding OutputGain}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.ColumnSpan="2" Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="4">
            <Canvas x:Name="WaveformCanvas" Height="140"/>
        </Border>
    </Grid>
</Window>
